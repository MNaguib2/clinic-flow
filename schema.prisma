generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum OrganizationStatus {
  active
  inactive
  suspended
}

enum ActiveStatus {
  active
  inactive
}

enum UserStatus {
  active
  inactive
  blocked
}

enum Gender {
  male
  female
  other
}

enum PatientStatus {
  active
  inactive
}

enum ShareStatus {
  active
  revoked
  expired
}

enum MedicalCaseStatus {
  open
  closed
}

enum AppointmentBookingType {
  new
  follow_up
}

enum AppointmentStatus {
  scheduled
  confirmed
  waiting
  completed
  cancelled
  no_show
}

enum AppointmentPriceType {
  normal
  follow_up
  discount
  free
}

enum MedicalRequestStatus {
  requested
  in_progress
  completed
  cancelled
}

enum ProductStatus {
  active
  inactive
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  cancelled
}

enum InvoiceItemType {
  product
  service
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  online
  other
}

enum PaymentStatus {
  pending
  completed
  cancelled
}

enum InventoryTransactionType {
  opening
  purchase
  sale
  purchase_return
  sale_return
  adjustment
}

// ============================================================
// 1. ORGANIZATIONS
// ============================================================

model Organization {
  id        BigInt             @id @default(autoincrement())
  name      String             @db.VarChar(200)
  code      String             @unique @db.VarChar(100)
  phone     String?            @db.VarChar(50)
  email     String?            @db.VarChar(255)
  address   String?            @db.Text
  status    OrganizationStatus @default(active)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  settings             OrganizationSettings?
  appointmentSettings  OrganizationAppointmentSettings?
  clinics              Clinic[]
  users                User[]
  roles                Role[]
  patientRecords       PatientRecord[]
  sourcePatientShares  PatientShare[] @relation("SourceOrganization")
  targetPatientShares  PatientShare[] @relation("TargetOrganization")
  doctorSchedules      DoctorSchedule[]
  clinicSchedules      ClinicSchedule[]
  medicalCases         MedicalCase[]
  appointments         Appointment[]
  visits               Visit[]
  diagnoses            Diagnosis[]
  prescriptions        Prescription[]
  medicalRequests      MedicalRequest[]
  attachments          Attachment[]
  products             Product[]
  productUnits         ProductUnit[]
  services             Service[]
  invoices             Invoice[]
  payments             Payment[]
  inventory            Inventory[]
  inventoryTransactions InventoryTransaction[]

  @@index([status])
  @@map("organizations")
}

// ============================================================
// 2. SPECIALTIES
// ============================================================

model Specialty {
  id        BigInt       @id @default(autoincrement())
  name      String       @unique @db.VarChar(150)
  status    ActiveStatus @default(active)
  createdAt DateTime     @default(now())

  doctorSpecialties DoctorSpecialty[]
  clinicSpecialties ClinicSpecialty[]

  @@map("specialties")
}

// ============================================================
// 3. PERMISSIONS
// ============================================================

model Permission {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(150)
  name        String   @db.VarChar(200)
  description String?  @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

// ============================================================
// 4. UNIT CATEGORIES
// ============================================================

model UnitCategory {
  id             BigInt  @id @default(autoincrement())
  name           String  @unique @db.VarChar(100)
  defaultUnitId  BigInt?
  status         ActiveStatus @default(active)
  createdAt      DateTime @default(now())

  defaultUnit Unit?  @relation("CategoryDefaultUnit", fields: [defaultUnitId], references: [id], onDelete: Restrict)
  units       Unit[] @relation("CategoryUnits")
  productUnits ProductUnit[]

  @@map("unit_categories")
}

// ============================================================
// 5. CLINICS
// ============================================================

model Clinic {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt
  name           String       @db.VarChar(200)
  code           String?      @db.VarChar(100)
  phone          String?      @db.VarChar(50)
  email          String?      @db.VarChar(255)
  address        String?      @db.Text
  status         ActiveStatus @default(active)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users              ClinicUser[]
  specialties        ClinicSpecialty[]
  doctorSchedules    DoctorSchedule[]
  schedules          ClinicSchedule[]
  appointments       Appointment[]
  invoices           Invoice[]
  inventory          Inventory[]
  inventoryTransactions InventoryTransaction[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("clinics")
}

// ============================================================
// 6. USERS
// ============================================================

model User {
  id             BigInt     @id @default(autoincrement())
  organizationId BigInt
  fullName       String     @db.VarChar(200)
  email          String?    @db.VarChar(255)
  phone          String?    @db.VarChar(50)
  passwordHash   String     @db.Text
  status         UserStatus @default(active)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastLoginAt    DateTime?

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles              UserRole[]
  clinics            ClinicUser[]
  specialties        DoctorSpecialty[]
  doctorSchedules    DoctorSchedule[]
  medicalCases       MedicalCase[]
  appointments       Appointment[]
  visits             Visit[]
  prescriptions      Prescription[]
  refreshTokens      RefreshToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([phone])
  @@map("users")
}

// ============================================================
// 7. ROLES
// ============================================================

model Role {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt
  name           String       @db.VarChar(100)
  description    String?      @db.Text
  status         ActiveStatus @default(active)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        UserRole[]
  permissions  RolePermission[]
  productUnitPermissions ProductUnitRolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

// ============================================================
// 8. ORGANIZATION SETTINGS
// ============================================================

model OrganizationSettings {
  organizationId        BigInt   @id
  inventoryEnabled      Boolean  @default(false)
  unitConversionEnabled Boolean  @default(false)
  timezone              String   @default("Africa/Cairo") @db.VarChar(100)
  currencyCode          String   @default("EGP") @db.VarChar(10)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// ============================================================
// 9. ORGANIZATION APPOINTMENT SETTINGS
// ============================================================

model OrganizationAppointmentSettings {
  organizationId            BigInt   @id
  examinationPrice          Decimal  @default(0) @db.Decimal(12, 2)
  followUpPrice             Decimal  @default(0) @db.Decimal(12, 2)
  discountedFollowUpCount  Int      @default(0)
  followUpPeriodDays       Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_appointment_settings")
}

// ============================================================
// 10. UNITS
// ============================================================

model Unit {
  id             BigInt  @id @default(autoincrement())
  unitCategoryId BigInt
  name           String  @db.VarChar(100)
  symbol         String? @db.VarChar(30)
  status         ActiveStatus @default(active)
  createdAt      DateTime @default(now())

  unitCategory          UnitCategory @relation("CategoryUnits", fields: [unitCategoryId], references: [id], onDelete: Restrict)
  defaultForCategories  UnitCategory[] @relation("CategoryDefaultUnit")
  productUnits          ProductUnit[]

  @@unique([unitCategoryId, name])
  @@index([unitCategoryId])
  @@map("units")
}

// ============================================================
// 11. USERS <-> ROLES
// ============================================================

model UserRole {
  userId    BigInt
  roleId    BigInt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================
// 12. ROLES <-> PERMISSIONS
// ============================================================

model RolePermission {
  roleId       BigInt
  permissionId BigInt
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================
// 13. CLINIC USERS
// ============================================================

model ClinicUser {
  clinicId  BigInt
  userId    BigInt
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clinicId, userId])
  @@index([userId])
  @@map("clinic_users")
}

// ============================================================
// 14. DOCTOR SPECIALTIES
// ============================================================

model DoctorSpecialty {
  userId      BigInt
  specialtyId BigInt
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([userId, specialtyId])
  @@index([specialtyId])
  @@map("doctor_specialties")
}

// ============================================================
// 15. CLINIC SPECIALTIES
// ============================================================

model ClinicSpecialty {
  clinicId    BigInt
  specialtyId BigInt
  createdAt   DateTime @default(now())

  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([clinicId, specialtyId])
  @@index([specialtyId])
  @@map("clinic_specialties")
}

// ============================================================
// 16. PATIENT ACCOUNTS
// ============================================================

model PatientAccount {
  id          BigInt         @id @default(autoincrement())
  fullName    String         @db.VarChar(200)
  phone       String?        @db.VarChar(50)
  email       String?        @db.VarChar(255)
  dateOfBirth DateTime?      @db.Date
  gender      Gender?
  nationalId  String?        @db.VarChar(100)
  status      PatientStatus  @default(active)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  records PatientRecord[]
  shares  PatientShare[]

  @@index([phone])
  @@index([nationalId])
  @@map("patient_accounts")
}

// ============================================================
// 17. PATIENT RECORDS
// ============================================================

model PatientRecord {
  id               BigInt @id @default(autoincrement())
  organizationId   BigInt
  patientAccountId BigInt
  address          String? @db.Text
  notes            String? @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Restrict)
  medicalCases MedicalCase[]
  appointments Appointment[]
  visits       Visit[]
  invoices     Invoice[]

  @@unique([organizationId, patientAccountId])
  @@index([patientAccountId])
  @@index([organizationId])
  @@map("patient_records")
}

// ============================================================
// 18. PATIENT SHARES
// ============================================================

model PatientShare {
  id                   BigInt      @id @default(autoincrement())
  patientAccountId     BigInt
  sourceOrganizationId BigInt
  targetOrganizationId BigInt
  status               ShareStatus @default(active)
  expiresAt            DateTime?
  createdAt            DateTime    @default(now())
  revokedAt            DateTime?

  patient PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)
  source  Organization   @relation("SourceOrganization", fields: [sourceOrganizationId], references: [id], onDelete: Cascade)
  target  Organization   @relation("TargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: Cascade)

  @@index([patientAccountId])
  @@index([sourceOrganizationId])
  @@index([targetOrganizationId])
  @@map("patient_shares")
}

// ============================================================
// 19. DOCTOR SCHEDULES
// ============================================================

model DoctorSchedule {
  id                   BigInt       @id @default(autoincrement())
  organizationId       BigInt
  clinicId             BigInt
  doctorId             BigInt
  dayOfWeek            Int          @db.UnsignedTinyInt
  startTime            DateTime     @db.Time(0)
  endTime              DateTime     @db.Time(0)
  slotDurationMinutes  Int          @default(30)
  status               ActiveStatus @default(active)
  createdAt            DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor       User         @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId])
  @@index([clinicId])
  @@index([organizationId])
  @@map("doctor_schedules")
}

// ============================================================
// 20. CLINIC SCHEDULES
// ============================================================

model ClinicSchedule {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt
  clinicId       BigInt
  dayOfWeek      Int          @db.UnsignedTinyInt
  startTime      DateTime     @db.Time(0)
  endTime        DateTime     @db.Time(0)
  status         ActiveStatus @default(active)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([clinicId])
  @@index([organizationId])
  @@map("clinic_schedules")
}

// ============================================================
// 21. MEDICAL CASES
// ============================================================

model MedicalCase {
  id              BigInt             @id @default(autoincrement())
  organizationId  BigInt
  patientRecordId BigInt
  doctorId        BigInt
  title           String?            @db.VarChar(255)
  description     String?            @db.Text
  status          MedicalCaseStatus  @default(open)
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      PatientRecord @relation(fields: [patientRecordId], references: [id], onDelete: Restrict)
  doctor       User          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  visits       Visit[]

  @@index([patientRecordId])
  @@index([doctorId])
  @@index([organizationId])
  @@map("medical_cases")
}

// ============================================================
// 22. APPOINTMENTS
// ============================================================

model Appointment {
  id               BigInt                  @id @default(autoincrement())
  organizationId   BigInt
  clinicId         BigInt
  patientRecordId  BigInt
  medicalCaseId    BigInt?
  doctorId         BigInt
  appointmentAt    DateTime
  bookingType      AppointmentBookingType
  followUpNumber   Int                     @default(0)
  status           AppointmentStatus        @default(scheduled)
  price            Decimal                 @default(0) @db.Decimal(12, 2)
  priceType        AppointmentPriceType     @default(normal)
  notes            String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient      PatientRecord @relation(fields: [patientRecordId], references: [id], onDelete: Restrict)
  medicalCase  MedicalCase?  @relation(fields: [medicalCaseId], references: [id], onDelete: Restrict)
  doctor       User          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  visits       Visit[]

  @@index([organizationId, appointmentAt])
  @@index([clinicId, appointmentAt])
  @@index([doctorId, appointmentAt])
  @@index([patientRecordId])
  @@index([medicalCaseId])
  @@map("appointments")
}

// ============================================================
// 23. VISITS
// ============================================================

model Visit {
  id              BigInt   @id @default(autoincrement())
  organizationId  BigInt
  appointmentId   BigInt?
  medicalCaseId   BigInt
  patientRecordId BigInt
  doctorId        BigInt
  visitAt         DateTime @default(now())
  complaints      String?  @db.Text
  examination     String?  @db.Text
  diagnosisSummary String? @db.Text
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  medicalCase    MedicalCase   @relation(fields: [medicalCaseId], references: [id], onDelete: Restrict)
  patient        PatientRecord @relation(fields: [patientRecordId], references: [id], onDelete: Restrict)
  doctor         User           @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  diagnoses      Diagnosis[]
  prescriptions  Prescription[]
  medicalRequests MedicalRequest[]
  attachments    Attachment[]

  @@index([patientRecordId])
  @@index([medicalCaseId])
  @@index([doctorId])
  @@index([appointmentId])
  @@map("visits")
}

// ============================================================
// 24. DIAGNOSES
// ============================================================

model Diagnosis {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt
  visitId        BigInt
  diagnosis      String   @db.Text
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  visit        Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("diagnoses")
}

// ============================================================
// 25. PRESCRIPTIONS
// ============================================================

model Prescription {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt
  visitId        BigInt
  doctorId       BigInt
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  visit        Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  doctor       User               @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  items        PrescriptionItem[]

  @@index([visitId])
  @@index([doctorId])
  @@map("prescriptions")
}

// ============================================================
// 26. PRESCRIPTION ITEMS
// ============================================================

model PrescriptionItem {
  id             BigInt   @id @default(autoincrement())
  prescriptionId BigInt
  medicationName String   @db.VarChar(255)
  dosage         String?  @db.VarChar(255)
  frequency      String?  @db.VarChar(255)
  duration       String?  @db.VarChar(255)
  instructions   String?  @db.Text
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ============================================================
// 27. MEDICAL REQUESTS
// ============================================================

model MedicalRequest {
  id             BigInt               @id @default(autoincrement())
  organizationId BigInt
  visitId        BigInt
  requestType    String               @db.VarChar(100)
  title          String?              @db.VarChar(255)
  description    String?              @db.Text
  status         MedicalRequestStatus  @default(requested)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  visit        Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("medical_requests")
}

// ============================================================
// 28. ATTACHMENTS
// ============================================================

model Attachment {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt
  visitId        BigInt?
  fileName       String   @db.VarChar(255)
  storageKey     String   @db.Text
  mimeType       String?  @db.VarChar(150)
  fileSize       BigInt?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  visit        Visit?       @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("attachments")
}

// ============================================================
// 29. PRODUCTS
// ============================================================

model Product {
  id                 BigInt      @id @default(autoincrement())
  organizationId     BigInt
  name               String      @db.VarChar(255)
  sku                String?     @db.VarChar(100)
  description        String?     @db.Text
  basePurchasePrice  Decimal     @default(0) @db.Decimal(12, 2)
  baseSalePrice      Decimal     @default(0) @db.Decimal(12, 2)
  status             ProductStatus @default(active)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  units        ProductUnit[]
  invoiceItems InvoiceItem[]
  inventory    Inventory[]
  inventoryTransactions InventoryTransaction[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("products")
}

// ============================================================
// 30. PRODUCT UNITS
// ============================================================

model ProductUnit {
  id             BigInt  @id @default(autoincrement())
  organizationId BigInt
  productId      BigInt
  unitCategoryId BigInt
  unitId         BigInt
  factorToBase   Decimal @default(1) @db.Decimal(18, 6)
  purchasePrice  Decimal @default(0) @db.Decimal(12, 2)
  salePrice      Decimal @default(0) @db.Decimal(12, 2)
  isSaleUnit     Boolean @default(false)
  isPurchaseUnit Boolean @default(false)
  status         ActiveStatus @default(active)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitCategory UnitCategory @relation(fields: [unitCategoryId], references: [id], onDelete: Restrict)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  permissions  ProductUnitRolePermission[]
  invoiceItems InvoiceItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
  @@index([unitCategoryId])
  @@map("product_units")
}

// ============================================================
// 31. PRODUCT UNIT ROLE PERMISSIONS
// ============================================================

model ProductUnitRolePermission {
  productUnitId BigInt
  roleId        BigInt
  createdAt     DateTime @default(now())

  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([productUnitId, roleId])
  @@index([roleId])
  @@map("product_unit_role_permissions")
}

// ============================================================
// 32. SERVICES
// ============================================================

model Service {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt
  name           String       @db.VarChar(255)
  description    String?      @db.Text
  salePrice      Decimal      @default(0) @db.Decimal(12, 2)
  status         ActiveStatus @default(active)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoiceItems InvoiceItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("services")
}

// ============================================================
// 33. INVOICES
// ============================================================

model Invoice {
  id              BigInt        @id @default(autoincrement())
  organizationId  BigInt
  clinicId        BigInt
  patientRecordId BigInt?
  invoiceNumber   String        @db.VarChar(100)
  invoiceDate     DateTime      @default(now())
  status          InvoiceStatus @default(draft)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient      PatientRecord? @relation(fields: [patientRecordId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, invoiceDate])
  @@index([clinicId, invoiceDate])
  @@index([patientRecordId])
  @@map("invoices")
}

// ============================================================
// 34. INVOICE ITEMS
// ============================================================

model InvoiceItem {
  id                       BigInt          @id @default(autoincrement())
  invoiceId                BigInt
  itemType                 InvoiceItemType
  productId                BigInt?
  serviceId                BigInt?
  productUnitId            BigInt?
  itemNameSnapshot         String          @db.VarChar(255)
  unitNameSnapshot         String?         @db.VarChar(100)
  conversionFactorSnapshot Decimal?        @db.Decimal(18, 6)
  quantity                 Decimal         @db.Decimal(18, 6)
  baseQuantity             Decimal?        @db.Decimal(18, 6)
  unitPrice                Decimal         @db.Decimal(12, 2)
  purchasePriceSnapshot    Decimal?        @db.Decimal(12, 2)
  discount                 Decimal         @default(0) @db.Decimal(12, 2)
  tax                      Decimal         @default(0) @db.Decimal(12, 2)
  total                    Decimal         @default(0) @db.Decimal(12, 2)
  createdAt                DateTime        @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: Restrict)
  inventoryTransactions InventoryTransaction[]

  @@index([invoiceId])
  @@index([productId])
  @@index([serviceId])
  @@index([productUnitId])
  @@map("invoice_items")
}

// ============================================================
// 35. PAYMENTS
// ============================================================

model Payment {
  id             BigInt        @id @default(autoincrement())
  organizationId BigInt
  invoiceId      BigInt
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  paymentDate    DateTime      @default(now())
  reference      String?       @db.VarChar(255)
  notes          String?       @db.Text
  status         PaymentStatus @default(completed)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([organizationId, paymentDate])
  @@map("payments")
}

// ============================================================
// 36. INVENTORY
// ============================================================

model Inventory {
  id             BigInt  @id @default(autoincrement())
  organizationId BigInt
  clinicId       BigInt
  productId      BigInt
  baseQuantity   Decimal @default(0) @db.Decimal(18, 6)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([clinicId, productId])
  @@index([organizationId, clinicId])
  @@index([productId])
  @@map("inventory")
}

// ============================================================
// 37. INVENTORY TRANSACTIONS
// ============================================================

model InventoryTransaction {
  id                       BigInt                   @id @default(autoincrement())
  organizationId           BigInt
  clinicId                 BigInt
  productId                BigInt
  productUnitId            BigInt?
  invoiceItemId            BigInt?
  transactionType          InventoryTransactionType
  quantity                 Decimal                  @db.Decimal(18, 6)
  conversionFactorSnapshot Decimal?                 @db.Decimal(18, 6)
  baseQuantity             Decimal                  @db.Decimal(18, 6)
  notes                    String?                  @db.Text
  createdAt                DateTime                 @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productUnit  ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: Restrict)
  invoiceItem  InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([clinicId])
  @@index([organizationId])
  @@index([invoiceItemId])
  @@map("inventory_transactions")
}

// ============================================================
// 38. AUTH / REFRESH TOKENS
// ============================================================

model RefreshToken {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt
  tokenHash    String   @unique @db.VarChar(255)
  expiresAt    DateTime
  revokedAt    DateTime?
  rememberMe   Boolean  @default(false)
  userAgent    String?  @db.VarChar(500)
  ipAddress    String?  @db.VarChar(45)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
