# MySQL connection used by Prisma.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/clinic_management"

# Use a unique random value of at least 32 characters in production.
SESSION_SECRET="replace-this-with-a-random-secret-at-least-32-characters"
SESSION_NAME=clinic.sid
SESSION_TTL=3600000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

PORT=3000
UPLOAD_DIR=./uploads

# Optional in development (HTTP/2 cleartext is used without certificates).
# Production requires both paths to enable TLS HTTP/2.
# TLS_KEY_PATH="/absolute/path/to/server.key"
# TLS_CERT_PATH="/absolute/path/to/server.crt"
