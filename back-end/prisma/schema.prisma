generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

model Organization {
  id                  BigInt                           @id @default(autoincrement())
  name                String                           @db.VarChar(150)
  logoUrl             String?                          @map("logo_url") @db.Text
  createdAt           DateTime                         @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt           DateTime                         @updatedAt @map("updated_at") @db.DateTime(6)
  briefDescription    String?                          @map("brief_description") @db.Text
  clinics             Clinic[]
  users               User[]
  roles               Role[]
  settings            OrganizationSettings?
  appointmentSettings OrganizationAppointmentSettings?
  patientRecords      PatientRecord[]
  sourceShares        PatientShare[]                   @relation("SourceOrganization")
  targetShares        PatientShare[]                   @relation("TargetOrganization")
  medicalCases        MedicalCase[]
  appointments        Appointment[]
  attachments         Attachment[]
  products            Product[]
  services            Service[]
  invoices            Invoice[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  recurringExpenses   RecurringExpense[]
  auditLogs           AuditLog[]
  specialties         Specialty[]
  rolePermissions     RolePermission[]

  @@map("organizations")
}

model Specialty {
  id                BigInt            @id @default(autoincrement())
  name              String            @unique @db.VarChar(150)
  imageUrl          String?           @map("image_url") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(6)
  organizationId    BigInt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorSpecialties DoctorSpecialty[]
  clinicSpecialties ClinicSpecialty[]

  @@map("specialties")
}

model GlobalSpecialty {
  id            BigInt   @id @default(autoincrement())
  code          String   @unique @db.VarChar(100)
  name_en       String   @db.VarChar(150)
  name_ar       String   @db.VarChar(150)
  description_en String  @db.Text
  description_ar String  @db.Text
  imageUrl      String   @map("image_url") @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)

  @@index([isActive, sortOrder])
  @@map("global_specialties")
}

model PermissionPage {
  id            BigInt       @id @default(autoincrement())
  key           String       @unique @db.VarChar(150)
  name_en       String       @db.VarChar(150)
  name_ar       String       @db.VarChar(150)
  description_en String      @db.Text
  description_ar String      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  permissions   Permission[]

  @@map("permission_pages")
}

model Permission {
  id              BigInt           @id @default(autoincrement())
  pageId          BigInt           @map("page_id")
  code            String           @unique @db.VarChar(150)
  name_en         String           @db.VarChar(150)
  name_ar         String           @db.VarChar(150)
  description_ar  String?          @db.Text
  description_en  String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(6)
  page            PermissionPage   @relation(fields: [pageId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]

  @@index([pageId])
  @@map("permissions")
}

model Drug {
  id               BigInt       @id @default(autoincrement())
  name             String       @db.VarChar(200)
  activeIngredient String?      @map("active_ingredient") @db.VarChar(200)
  concentration    String?      @db.VarChar(100)
  dosageForm       String?      @map("dosage_form") @db.VarChar(100)
  description      String?      @db.Text
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  doctorEntries    DoctorDrug[]

  @@index([name])
  @@index([activeIngredient])
  @@index([isActive, name])
  @@map("drugs")
}

model UnitCategory {
  id            BigInt   @id @default(autoincrement())
  name          String   @unique @db.VarChar(100)
  defaultUnitId BigInt?  @map("default_unit_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  defaultUnit   Unit?    @relation("CategoryDefaultUnit", fields: [defaultUnitId], references: [id], onDelete: Restrict)
  units         Unit[]   @relation("CategoryUnits")

  @@map("unit_categories")
}

model Clinic {
  id             BigInt             @id @default(autoincrement())
  organizationId BigInt             @map("organization_id")
  name           String             @db.VarChar(150)
  phone          String?            @db.VarChar(30)
  address        String?            @db.Text
  imageUrl       String?            @map("image_url") @db.Text
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.DateTime(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          ClinicUser[]
  specialties    ClinicSpecialty[]
  schedules      ClinicSchedule[]
  medicalCases   MedicalCase[]
  appointments   Appointment[]
  invoices       Invoice[]
  inventory      Inventory[]
  expenses       Expense[]
  recurring      RecurringExpense[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("clinics")
}

model User {
  id                         BigInt                 @id @default(autoincrement())
  organizationId             BigInt                 @map("organization_id")
  fullName                   String                 @map("full_name") @db.VarChar(150)
  email                      String                 @unique @db.VarChar(255)
  phoneNumber                String?                @map("phone_number") @db.VarChar(30)
  birthday                   DateTime?              @db.Date
  passwordHash               String                 @map("password_hash") @db.Text
  isActive                   Boolean                @default(true) @map("is_active")
  lastLoginAt                DateTime?              @map("last_login_at") @db.DateTime(6)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.DateTime(6)
  certifications             Json?                  @db.Json
  previousWorkingExperiences Json?                  @map("previous_working_experiences") @db.Json
  currentWorkingExperiences  Json?                  @map("current_working_experiences") @db.Json
  jobTitle                   String?                @map("job_title") @db.VarChar(100)
  profileImageUrl            String?                @map("profile_image_url") @db.Text
  portfolioUrl               String?                @map("portfolio_url") @db.Text
  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles                      UserRole[]
  clinics                    ClinicUser[]
  specialties                DoctorSpecialty[]
  doctorSchedules            DoctorSchedule[]
  openedCases                MedicalCase[]          @relation("MedicalCaseOpenedBy")
  appointments               Appointment[]          @relation("AppointmentDoctor")
  visits                     Visit[]
  attachments                Attachment[]
  createdInvoices            Invoice[]              @relation("InvoiceCreatedBy")
  createdPayments            Payment[]              @relation("PaymentCreatedBy")
  inventoryTransactions      InventoryTransaction[]
  createdExpenses            Expense[]              @relation("ExpenseCreatedBy")
  createdRecurringExpenses   RecurringExpense[]     @relation("RecurringExpenseCreatedBy")
  refreshTokens              RefreshToken[]
  loginSessions              LoginSession[]
  passwordResetTokens        PasswordResetToken[]
  auditLogs                  AuditLog[]
  doctorDrugs                DoctorDrug[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("users")
}

model DoctorDrug {
  id                  BigInt             @id @default(autoincrement())
  userId              BigInt             @map("user_id")
  drugId              BigInt?            @map("drug_id")
  customName          String?            @map("custom_name") @db.VarChar(200)
  customDescription   String?            @map("custom_description") @db.Text
  defaultDosage       String?            @map("default_dosage") @db.VarChar(100)
  defaultFrequency    String?            @map("default_frequency") @db.VarChar(100)
  defaultDuration     String?            @map("default_duration") @db.VarChar(100)
  defaultInstructions String?            @map("default_instructions") @db.Text
  isFavorite          Boolean            @default(false) @map("is_favorite")
  createdAt           DateTime           @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.DateTime(6)
  doctor              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  drug                Drug?              @relation(fields: [drugId], references: [id], onDelete: Restrict)
  prescriptionItems   PrescriptionItem[]

  @@unique([userId, drugId])
  @@index([userId])
  @@index([drugId])
  @@map("doctor_drugs")
}

model Role {
  id                     BigInt                      @id @default(autoincrement())
  organizationId         BigInt                      @map("organization_id")
  name                   String                      @db.VarChar(100)
  description            String?                     @db.Text
  isSystemRole           Boolean                     @default(false) @map("is_system_role")
  createdAt              DateTime                    @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.DateTime(6)
  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users                  UserRole[]
  permissions            RolePermission[]
  productUnitPermissions ProductUnitRolePermission[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("roles")
}

model OrganizationSettings {
  organizationId BigInt       @id @map("organization_id")
  currencyCode   String       @default("EGP") @map("currency_code") @db.VarChar(10)
  country        String?      @db.VarChar(100)
  city           String?      @db.VarChar(100)
  language       String       @default("en") @db.VarChar(10)
  timezone       String       @default("Africa/Cairo") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OrganizationAppointmentSettings {
  organizationId          BigInt       @id @map("organization_id")
  mainExamPrice           Decimal      @default(0) @map("main_exam_price") @db.Decimal(12, 2)
  followUpPrice           Decimal      @default(0) @map("follow_up_price") @db.Decimal(12, 2)
  discountedFollowUpCount Int          @default(1) @map("discounted_follow_up_count")
  followUpPeriodDays      Int          @default(15) @map("follow_up_period_days")
  createdAt               DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_appointment_settings")
}

model Unit {
  id                   BigInt         @id @default(autoincrement())
  unitCategoryId       BigInt         @map("unit_category_id")
  name                 String         @db.VarChar(100)
  symbol               String?        @db.VarChar(30)
  createdAt            DateTime       @default(now()) @map("created_at") @db.DateTime(6)
  unitCategory         UnitCategory   @relation("CategoryUnits", fields: [unitCategoryId], references: [id], onDelete: Restrict)
  defaultForCategories UnitCategory[] @relation("CategoryDefaultUnit")
  productUnits         ProductUnit[]

  @@unique([unitCategoryId, name])
  @@unique([unitCategoryId, id])
  @@map("units")
}

model UserRole {
  userId    BigInt   @map("user_id")
  roleId    BigInt   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId         BigInt       @map("role_id")
  permissionId   BigInt       @map("permission_id")
  organizationId BigInt       @map("organization_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model ClinicUser {
  clinicId  BigInt   @map("clinic_id")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clinicId, userId])
  @@index([userId])
  @@map("clinic_users")
}

model DoctorSpecialty {
  userId      BigInt    @map("user_id")
  specialtyId BigInt    @map("specialty_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([userId, specialtyId])
  @@index([specialtyId])
  @@map("doctor_specialties")
}

model ClinicSpecialty {
  clinicId    BigInt    @map("clinic_id")
  specialtyId BigInt    @map("specialty_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([clinicId, specialtyId])
  @@index([specialtyId])
  @@map("clinic_specialties")
}

model PatientAccount {
  id          BigInt          @id @default(autoincrement())
  fullName    String          @map("full_name") @db.VarChar(150)
  phone       String          @db.VarChar(30)
  dateOfBirth DateTime?       @map("date_of_birth") @db.Date
  gender      String?         @db.VarChar(20)
  nationalId  String?         @map("national_id") @db.VarChar(50)
  address     String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(6)
  records     PatientRecord[]
  shares      PatientShare[]

  @@index([phone])
  @@map("patient_accounts")
}

model PatientRecord {
  id                  BigInt         @id @default(autoincrement())
  organizationId      BigInt         @map("organization_id")
  patientAccountId    BigInt         @map("patient_account_id")
  medicalRecordNumber String?        @map("medical_record_number") @db.VarChar(100)
  notes               String?        @db.Text
  createdAt           DateTime       @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.DateTime(6)
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient             PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)
  medicalCases        MedicalCase[]
  appointments        Appointment[]
  invoices            Invoice[]
  attachments         Attachment[]

  @@unique([organizationId, patientAccountId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("patient_records")
}

model PatientShare {
  id                 BigInt         @id @default(autoincrement())
  patientAccountId   BigInt         @map("patient_account_id")
  fromOrganizationId BigInt         @map("from_organization_id")
  toOrganizationId   BigInt         @map("to_organization_id")
  grantedAt          DateTime       @default(now()) @map("granted_at") @db.DateTime(6)
  revokedAt          DateTime?      @map("revoked_at") @db.DateTime(6)
  patient            PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)
  source             Organization   @relation("SourceOrganization", fields: [fromOrganizationId], references: [id], onDelete: Cascade)
  target             Organization   @relation("TargetOrganization", fields: [toOrganizationId], references: [id], onDelete: Cascade)

  @@index([patientAccountId])
  @@map("patient_shares")
}

model DoctorSchedule {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  doctor    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("doctor_schedules")
}

model ClinicSchedule {
  id        BigInt   @id @default(autoincrement())
  clinicId  BigInt   @map("clinic_id")
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_schedules")
}

model MedicalCase {
  id              BigInt        @id @default(autoincrement())
  organizationId  BigInt        @map("organization_id")
  patientRecordId BigInt        @map("patient_record_id")
  clinicId        BigInt?       @map("clinic_id")
  openedBy        BigInt?       @map("opened_by")
  openedAt        DateTime      @default(now()) @map("opened_at") @db.DateTime(6)
  closedAt        DateTime?     @map("closed_at") @db.DateTime(6)
  status          String        @default("open") @db.VarChar(20)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(6)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         PatientRecord @relation(fields: [patientRecordId], references: [id], onDelete: Restrict)
  clinic          Clinic?       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  opener          User?         @relation("MedicalCaseOpenedBy", fields: [openedBy], references: [id], onDelete: SetNull)
  appointments    Appointment[]

  @@index([patientRecordId])
  @@map("medical_cases")
}

model Appointment {
  id              BigInt        @id @default(autoincrement())
  organizationId  BigInt        @map("organization_id")
  clinicId        BigInt        @map("clinic_id")
  patientRecordId BigInt        @map("patient_record_id")
  medicalCaseId   BigInt?       @map("medical_case_id")
  doctorId        BigInt        @map("doctor_id")
  appointmentAt   DateTime      @map("appointment_at") @db.DateTime(6)
  bookingType     String        @map("booking_type") @db.VarChar(20)
  followUpNumber  Int?          @map("follow_up_number")
  status          String        @default("scheduled") @db.VarChar(30)
  price           Decimal       @default(0) @db.Decimal(12, 2)
  priceType       String        @map("price_type") @db.VarChar(30)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(6)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic          Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         PatientRecord @relation(fields: [patientRecordId], references: [id], onDelete: Restrict)
  medicalCase     MedicalCase?  @relation(fields: [medicalCaseId], references: [id], onDelete: SetNull)
  doctor          User          @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  visit           Visit?

  @@index([doctorId, appointmentAt])
  @@index([patientRecordId, appointmentAt])
  @@index([clinicId, appointmentAt])
  @@map("appointments")
}

model Visit {
  id            BigInt           @id @default(autoincrement())
  appointmentId BigInt           @unique @map("appointment_id")
  doctorId      BigInt           @map("doctor_id")
  startedAt     DateTime?        @map("started_at") @db.DateTime(6)
  completedAt   DateTime?        @map("completed_at") @db.DateTime(6)
  notes         String?          @db.Text
  createdAt     DateTime         @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.DateTime(6)
  appointment   Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        User             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  requests      MedicalRequest[]
  attachments   Attachment[]

  @@map("visits")
}

model Diagnosis {
  id        BigInt   @id @default(autoincrement())
  visitId   BigInt   @map("visit_id")
  diagnosis String   @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("diagnoses")
}

model Prescription {
  id        BigInt             @id @default(autoincrement())
  visitId   BigInt             @map("visit_id")
  notes     String?            @db.Text
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(6)
  visit     Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  items     PrescriptionItem[]

  @@index([visitId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             BigInt       @id @default(autoincrement())
  prescriptionId BigInt       @map("prescription_id")
  doctorDrugId   BigInt?      @map("doctor_drug_id")
  medicationName String       @map("medication_name") @db.VarChar(200)
  dosage         String?      @db.VarChar(100)
  frequency      String?      @db.VarChar(100)
  duration       String?      @db.VarChar(100)
  instructions   String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  doctorDrug     DoctorDrug?  @relation(fields: [doctorDrugId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@index([doctorDrugId])
  @@map("prescription_items")
}

model MedicalRequest {
  id          BigInt       @id @default(autoincrement())
  visitId     BigInt       @map("visit_id")
  requestType String       @map("request_type") @db.VarChar(50)
  description String?      @db.Text
  status      String       @default("requested") @db.VarChar(30)
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  visit       Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([visitId])
  @@map("medical_requests")
}

model Attachment {
  id               BigInt          @id @default(autoincrement())
  organizationId   BigInt          @map("organization_id")
  patientRecordId  BigInt?         @map("patient_record_id")
  visitId          BigInt?         @map("visit_id")
  medicalRequestId BigInt?         @map("medical_request_id")
  fileName         String          @map("file_name") @db.Text
  fileUrl          String          @map("file_url") @db.Text
  mimeType         String?         @map("mime_type") @db.VarChar(100)
  fileSize         BigInt?         @map("file_size")
  uploadedBy       BigInt?         @map("uploaded_by")
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(6)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient          PatientRecord?  @relation(fields: [patientRecordId], references: [id], onDelete: Cascade)
  visit            Visit?          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicalRequest   MedicalRequest? @relation(fields: [medicalRequestId], references: [id], onDelete: Cascade)
  uploader         User?           @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([patientRecordId])
  @@map("attachments")
}

model Product {
  id             BigInt        @id @default(autoincrement())
  organizationId BigInt        @map("organization_id")
  name           String        @db.VarChar(200)
  barcode        String?       @db.VarChar(100)
  description    String?       @db.Text
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units          ProductUnit[]
  invoiceItems   InvoiceItem[]
  inventory      Inventory[]

  @@unique([organizationId, id])
  @@index([organizationId, barcode])
  @@map("products")
}

model ProductUnit {
  id             BigInt                      @id @default(autoincrement())
  productId      BigInt                      @map("product_id")
  unitId         BigInt                      @map("unit_id")
  factorToBase   Decimal                     @default(1) @map("factor_to_base") @db.Decimal(18, 6)
  purchasePrice  Decimal?                    @map("purchase_price") @db.Decimal(12, 2)
  salePrice      Decimal?                    @map("sale_price") @db.Decimal(12, 2)
  isPurchaseUnit Boolean                     @default(false) @map("is_purchase_unit")
  isSaleUnit     Boolean                     @default(false) @map("is_sale_unit")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.DateTime(6)
  product        Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit           Unit                        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  permissions    ProductUnitRolePermission[]
  invoiceItems   InvoiceItem[]
  transactions   InventoryTransaction[]

  @@unique([productId, unitId])
  @@index([productId])
  @@map("product_units")
}

model ProductUnitRolePermission {
  productUnitId BigInt      @map("product_unit_id")
  roleId        BigInt      @map("role_id")
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(6)
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([productUnitId, roleId])
  @@index([roleId])
  @@map("product_unit_role_permissions")
}

model Service {
  id             BigInt        @id @default(autoincrement())
  organizationId BigInt        @map("organization_id")
  name           String        @db.VarChar(200)
  description    String?       @db.Text
  price          Decimal       @default(0) @db.Decimal(12, 2)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems   InvoiceItem[]

  @@map("services")
}

model Invoice {
  id              BigInt         @id @default(autoincrement())
  organizationId  BigInt         @map("organization_id")
  clinicId        BigInt?        @map("clinic_id")
  patientRecordId BigInt?        @map("patient_record_id")
  invoiceNumber   String         @map("invoice_number") @db.VarChar(100)
  invoiceDate     DateTime       @default(now()) @map("invoice_date") @db.DateTime(6)
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  tax             Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @default(0) @db.Decimal(12, 2)
  status          String         @default("unpaid") @db.VarChar(30)
  notes           String?        @db.Text
  createdBy       BigInt?        @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(6)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic          Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  patient         PatientRecord? @relation(fields: [patientRecordId], references: [id], onDelete: SetNull)
  creator         User?          @relation("InvoiceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  payments        Payment[]

  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id               BigInt       @id @default(autoincrement())
  invoiceId        BigInt       @map("invoice_id")
  productId        BigInt?      @map("product_id")
  productUnitId    BigInt?      @map("product_unit_id")
  serviceId        BigInt?      @map("service_id")
  itemName         String       @map("item_name") @db.VarChar(255)
  quantity         Decimal      @default(1) @db.Decimal(18, 6)
  unitName         String?      @map("unit_name") @db.VarChar(100)
  conversionFactor Decimal?     @map("conversion_factor") @db.Decimal(18, 6)
  unitPrice        Decimal      @default(0) @map("unit_price") @db.Decimal(12, 2)
  discount         Decimal      @default(0) @db.Decimal(12, 2)
  total            Decimal      @default(0) @db.Decimal(12, 2)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  invoice          Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  productUnit      ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: Restrict)
  service          Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            BigInt   @id @default(autoincrement())
  invoiceId     BigInt   @map("invoice_id")
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   @map("payment_method") @db.VarChar(50)
  paidAt        DateTime @default(now()) @map("paid_at") @db.DateTime(6)
  notes         String?  @db.Text
  createdBy     BigInt?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  creator       User?    @relation("PaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("payments")
}

model Inventory {
  id           BigInt                 @id @default(autoincrement())
  clinicId     BigInt                 @map("clinic_id")
  productId    BigInt                 @map("product_id")
  quantity     Decimal                @default(0) @db.Decimal(18, 6)
  createdAt    DateTime               @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.DateTime(6)
  clinic       Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@unique([clinicId, productId])
  @@index([productId])
  @@map("inventory")
}

model InventoryTransaction {
  id              BigInt       @id @default(autoincrement())
  inventoryId     BigInt       @map("inventory_id")
  productUnitId   BigInt?      @map("product_unit_id")
  transactionType String       @map("transaction_type") @db.VarChar(30)
  quantity        Decimal      @db.Decimal(18, 6)
  quantityInBase  Decimal      @map("quantity_in_base") @db.Decimal(18, 6)
  referenceType   String?      @map("reference_type") @db.VarChar(50)
  referenceId     BigInt?      @map("reference_id")
  notes           String?      @db.Text
  createdBy       BigInt?      @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  inventory       Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productUnit     ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: Restrict)
  creator         User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@map("inventory_transactions")
}

model ExpenseCategory {
  id             BigInt @id @default(autoincrement())
  organizationId BigInt @map("organization_id")
  name           String @db.VarChar(150)

  // Used for personal drugs or a doctor's custom display name.
  description       String?            @db.Text
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(6)
  // Optional defaults to speed up prescription entry.
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(6)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("expense_categories")
}

model Expense {
  id                 BigInt            @id @default(autoincrement())
  organizationId     BigInt            @map("organization_id")
  clinicId           BigInt?           @map("clinic_id")
  categoryId         BigInt?           @map("category_id")
  recurringExpenseId BigInt?           @map("recurring_expense_id")
  title              String            @db.VarChar(200)
  description        String?           @db.Text
  amount             Decimal           @db.Decimal(12, 2)
  expenseDate        DateTime          @default(dbgenerated("(CURRENT_DATE)")) @map("expense_date") @db.Date
  paymentMethod      String?           @map("payment_method") @db.VarChar(50)
  referenceNumber    String?           @map("reference_number") @db.VarChar(100)
  createdBy          BigInt?           @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.DateTime(6)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic             Clinic?           @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  category           ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  creator            User?             @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId, expenseDate])
  @@index([clinicId, expenseDate])
  @@index([categoryId])
  @@index([recurringExpenseId])
  @@map("expenses")
}

model RecurringExpense {
  id             BigInt           @id @default(autoincrement())
  organizationId BigInt           @map("organization_id")
  clinicId       BigInt?          @map("clinic_id")
  categoryId     BigInt?          @map("category_id")
  title          String           @db.VarChar(200)
  description    String?          @db.Text
  amount         Decimal          @db.Decimal(12, 2)
  recurrenceType String           @map("recurrence_type") @db.VarChar(20)
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  nextDueDate    DateTime         @map("next_due_date") @db.Date
  paymentMethod  String?          @map("payment_method") @db.VarChar(50)
  isActive       Boolean          @default(true) @map("is_active")
  createdBy      BigInt?          @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinic         Clinic?          @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  category       ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator        User?            @relation("RecurringExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  expenses       Expense[]

  @@index([organizationId, nextDueDate, isActive])
  @@map("recurring_expenses")
}

model RefreshToken {
  id        BigInt         @id @default(autoincrement())
  userId    BigInt         @map("user_id")
  tokenHash String         @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime       @map("expires_at") @db.DateTime(6)
  revokedAt DateTime?      @map("revoked_at") @db.DateTime(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.DateTime(6)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  LoginSession[]

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LoginSession {
  id             BigInt  @id @default(autoincrement())
  userId         BigInt  @map("user_id")
  refreshTokenId BigInt? @map("refresh_token_id")

  // Historical snapshots: do not derive these from the catalog later.
  deviceName   String?       @map("device_name") @db.VarChar(150)
  deviceType   String?       @map("device_type") @db.VarChar(50)
  ipAddress    String?       @map("ip_address") @db.VarChar(45)
  lastUsedAt   DateTime?     @map("last_used_at") @db.DateTime(6)
  expiresAt    DateTime      @map("expires_at") @db.DateTime(6)
  revokedAt    DateTime?     @map("revoked_at") @db.DateTime(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("login_sessions")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(6)
  usedAt    DateTime? @map("used_at") @db.DateTime(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AuditLog {
  id             BigInt        @id @default(autoincrement())
  organizationId BigInt?       @map("organization_id")
  userId         BigInt?       @map("user_id")
  action         String        @db.VarChar(100)
  entityType     String?       @map("entity_type") @db.VarChar(100)
  entityId       String?       @map("entity_id") @db.Text
  oldData        Json?         @map("old_data")
  newData        Json?         @map("new_data")
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Session {
  id        BigInt @id @default(autoincrement())
  sessionId String @unique @map("session_id") @db.VarChar(255)

  data Json

  expiresAt DateTime? @map("expires_at") @db.DateTime(6)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  @@index([expiresAt])
  @@map("sessions")
}
