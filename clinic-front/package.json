{
  "name": "clinic-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:clinic-front": "node dist/clinic-front/server/server.mjs",
    "build:bootstrap": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import,global-builtin,color-functions --no-source-map --style=compressed src/theme/bootstrap.scss src/public/bootstrap/bootstrap.min.css && rtlcss src/public/bootstrap/bootstrap.min.css src/public/bootstrap/bootstrap.rtl.min.css",
    "prestart": "npm run build:bootstrap",
    "prebuild": "npm run build:bootstrap",
    "prewatch": "npm run build:bootstrap",
    "pretest": "npm run build:bootstrap"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "intl-tel-input": "^29.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "rtlcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
